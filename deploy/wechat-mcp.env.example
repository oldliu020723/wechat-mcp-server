# Runtime configuration for wechat-mcp-server.
#
# Install (run from /opt/wechat-mcp-server/deploy):
#   sudo install -d -m 0750 -o root -g wechat-mcp /etc/wechat-mcp
#   sudo install -m 0640 -o root -g wechat-mcp wechat-mcp.env.example \
#        /etc/wechat-mcp/wechat-mcp.env
#   sudo editor /etc/wechat-mcp/wechat-mcp.env
#
# systemd reads this file directly - it is NOT a shell script. Use bare
# KEY=VALUE lines: no "export", no surrounding quotes, no $expansion, and a
# "#" only starts a comment at the beginning of a line. A bad line shows up
# in `journalctl -u wechat-mcp` when the service starts.
#
# After editing, apply the changes with:
#   sudo systemctl restart wechat-mcp

# -----------------------------------------------------------------------------
# Network
# -----------------------------------------------------------------------------

# Address and port to bind. 0.0.0.0 listens on every interface, which is what
# you want when the client sits on another machine. If you change the port,
# open it in the firewall too.
WECHAT_MCP_LISTEN_HOST=0.0.0.0
WECHAT_MCP_LISTEN_PORT=8000

# The host clients put in the URL, and therefore the value they send in the
# Host header. It must match, or the server refuses every request as a
# possible DNS-rebinding attempt. If clients call
# http://192.168.1.10:8000/mcp then this is 192.168.1.10. Use the bare IP or
# hostname - no scheme, no port.
WECHAT_MCP_ALLOWED_HOST=<YOUR_SERVER_IP>

# -----------------------------------------------------------------------------
# Credentials
# -----------------------------------------------------------------------------

# Bearer token for the HTTP transport. The startup fail-safe requires it
# whenever the bind address is not loopback, and rejects anything under 32
# characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WECHAT_MCP_AUTH_TOKEN=<PASTE_GENERATED_TOKEN>

# Default Official Account credentials. Optional, but without them every tool
# call has to carry its own appid/appsecret, and create_wechat_draft needs an
# access_token passed explicitly.
WECHAT_APPID=<YOUR_APPID>
WECHAT_APPSECRET=<YOUR_APPSECRET>
